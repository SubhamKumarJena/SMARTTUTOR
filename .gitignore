# SmartTutor — .gitignore
# =========================
# Files and directories that should NOT be committed to version control.

# ---- System Files ----
.DS_Store           # macOS folder metadata
Thumbs.db           # Windows folder thumbnail cache
desktop.ini         # Windows folder settings
*.swp               # Vim swap files

# ---- Editor / IDE ----
.vscode/settings.json  # VS Code user-specific settings (keep extensions.json if useful)
.idea/              # JetBrains IDE files

# ---- Environment & Secrets ----
# NEVER commit API keys, passwords, or secret tokens.
.env
.env.local
.env.production
*.key
secrets.js

# ---- Python (if Flask backend is added) ----
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
instance/

# ---- Node (if build tools are added later) ----
node_modules/
npm-debug.log*
.npm/

# ---- Build output (if added later) ----
/dist/
/build/

# ---- Logs ----
*.log
